# ==========================================================
# Agentic Healthcare Assistant - configuration template
# Copy this file to `.env` and fill in your own values.
#
# NEVER put a real API key in this file, in git, or in the
# Streamlit app settings that are stored in the repo.
#
# Local:        copy to `.env` (gitignored)
# Streamlit:    paste the same keys in the Cloud dashboard
#               under App settings → Secrets (also gitignored)
# ==========================================================

# --- LLM (Groq) -------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# Main reasoning model used by the planner agent
GROQ_MODEL=openai/gpt-oss-120b
# Smaller/faster model used for evaluation and lightweight calls
GROQ_EVAL_MODEL=openai/gpt-oss-20b
# Vision model used to read attached images (PNG/JPG)
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=2048
GROQ_TIMEOUT=60

# --- Embeddings (local, no API key needed) ----------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector database (FAISS) ------------------------------
VECTOR_DB=faiss
FAISS_INDEX_DIR=data/faiss_index
FAISS_TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Local data stores ------------------------------------
EHR_DB_PATH=data/healthcare.db
SEED_ON_STARTUP=true

# --- Medical information search ---------------------------
# MedlinePlus Connect / NCBI E-utilities are free and need no key
MEDLINE_SEARCH_URL=https://wsearch.nlm.nih.gov/ws/query
WHO_FACTSHEET_URL=https://www.who.int/news-room/fact-sheets
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=30

# --- Application ------------------------------------------
APP_TITLE=Health Care Assistant Agent
LOG_DIR=logs
LOG_LEVEL=INFO
MEMORY_WINDOW=10
