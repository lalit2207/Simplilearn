# Copy this file to secrets.toml for local Streamlit secret testing,
# or paste the same TOML into Streamlit Community Cloud:
#   App dashboard → ⋮ → Settings → Secrets
#
# secrets.toml is gitignored. Do not put a real key in this example.

GROQ_API_KEY = "PASTE_YOUR_GROQ_KEY_HERE"
GROQ_MODEL = "openai/gpt-oss-120b"
GROQ_EVAL_MODEL = "openai/gpt-oss-20b"
GROQ_TEMPERATURE = "0.2"
GROQ_MAX_TOKENS = "2048"
GROQ_TIMEOUT = "60"
